# Copy to .env for local development. Never commit the real .env file.
# In staging/production, these are injected by the hosting platform's
# secret store (Fly.io secrets, etc.) — this file only documents the names.

# development | production | test
NODE_ENV=development

# HTTP server bind address/port
HOST=0.0.0.0
PORT=4000

# Postgres connection string (local Docker Postgres for development).
# postgres://<user>:<password>@<host>:<port>/<database>
DATABASE_URL=postgres://postgres:postgres@localhost:5432/secure_messenger

# trace | debug | info | warn | error | fatal | silent
LOG_LEVEL=debug

# Allowed origin(s) for browser-based clients. The mobile app does not
# send an Origin header, so this mainly matters for local tooling.
CORS_ORIGIN=*

# Which upstream proxy hops may be believed when deriving the real
# client IP from X-Forwarded-For. This directly controls whether per-IP
# rate limits are per-client or one globally shared bucket, so it is
# security-relevant — see server/src/config/trustProxy.ts.
#
#   unset/false  trust nothing; request.ip is the socket peer.
#                Correct for local development and direct exposure.
#   <number>     trust exactly N hops.
#   <list>       comma-separated IPs/CIDRs/named ranges (loopback,
#                linklocal, uniquelocal). Recommended form.
#
# Left unset, this defaults to false in development and to Railway's
# proxy range in production. Override only if your edge differs.
# TRUST_PROXY=100.0.0.0/8,loopback,linklocal,uniquelocal

# Secret mixed into every password/recovery-code hash before Argon2id.
# Generate with: openssl rand -base64 32
# Rotating this invalidates every existing hash — treat it like a signing key.
ARGON2_PEPPER=replace-with-a-random-32-byte-value

# Signs access tokens (JWT) and short-lived recovery tokens. A different
# secret from ARGON2_PEPPER on purpose — a leak of one must not compromise
# the other. Generate with: openssl rand -base64 32
ACCESS_TOKEN_SECRET=replace-with-a-different-random-32-byte-value

# Local-disk directory where opaque (already MLS-encrypted) voice-message
# blobs are stored. Created automatically if missing.
MEDIA_STORAGE_DIR=./data/media
