# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# Claude Code / agent tooling — local only, not part of the app
.claude/
.agents/

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision
*.keystore
keystore.properties

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# Firebase Android client config (project messenger-68098). Needed locally to
# build; kept out of the repo. Never put the server's FCM service account
# key anywhere in the project — it belongs only in Railway's variables.
google-services.json
# Firebase/Google service account private keys (the server's FCM credential).
# Never commit these; the key belongs only in Railway's variables.
*-firebase-adminsdk-*.json
*service-account*.json

# environment secrets — never commit real values
.env
.env.*
!.env.example
!.env.*.example

# typescript
*.tsbuildinfo

# generated native folders
/ios
/android

# Rust (mls-core E2EE crypto foundation)
# Cargo.lock is intentionally NOT ignored — this crate is
# security-sensitive (OpenMLS + crypto deps), so pinned, reproducible,
# reviewable dependency versions matter here the same way
# package-lock.json is already committed for the JS side.
modules/mls-core/rust/target/

# Rust cross-compile output for Android — regenerate via `cargo ndk`
# (see the Phase 5B report for the exact command), never commit the
# compiled .so directly.
modules/mls-core/android/src/main/jniLibs/

# Gradle build output for the local Expo module
modules/mls-core/android/build/
modules/mls-core/android/.cxx/

# Gradle build output for the local app-updater Expo module
modules/app-updater/android/build/

# Gradle build output for the local call-session Expo module
modules/call-session/android/build/
modules/call-session/android/.cxx/

# Local run logs from launching the dev stack (Metro, the emulator, the
# API server, Gradle). Regenerated on every run; never useful in review.
*.log

# UI hierarchy dumps captured off an emulator while debugging.
ui_*.xml

# Voice-message blob storage for a local dev server — runtime data, and
# the blobs are user content even though they are opaque ciphertext.
server/data/
